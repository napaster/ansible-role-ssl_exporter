{{ '## ssl_exporter.service' }}
{{ '# ' + ansible_managed }}
{{ '# Do not edit manually' }}

{{ '[Unit]' }}
{{ 'Description=Prometheus exporter for SSL metrics' }}
{{ 'Documentation=https://github.com/piotrkochan/ssl_exporter' }}
{{ 'After=network.target network-online.target nss-lookup.target basic.target' }}
{{ 'Wants=network-online.target nss-lookup.target' }}
{{ 'StartLimitIntervalSec=30' }}
{{ 'StartLimitBurst=3' }}

{{ '[Service]' }}
{{ 'User=nobody' }}
{{ 'Group=' + ('nogroup' if ansible_os_family == 'Debian' else 'nobody') }}
{{ 'Restart=on-failure' }}
{{ 'RestartSec=30' }}
{{ 'ExecReload=/bin/kill -HUP $MAINPID' }}
{{ 'NoNewPrivileges=true' }}
{{ 'ProtectHome=true' }}
{{ 'ProtectSystem=strict' }}
{{ 'ProtectHostname=true' }}
{{ 'ProtectControlGroups=true' }}
{{ 'ProtectKernelModules=true' }}
{{ 'ProtectKernelTunables=true' }}
{{ 'LockPersonality=true' }}
{{ 'RestrictRealtime=yes' }}
{{ 'RestrictNamespaces=yes' }}
{{ 'MemoryDenyWriteExecute=yes' }}
{{ 'PrivateDevices=yes' }}
{{ 'PrivateTmp=true' }}
{{ 'CapabilityBoundingSet=' }}
{{ 'ExecStart=' + lookup('ansible.builtin.vars', 'ssl_exporter_dest') +
  '/ssl_exporter --config.file=' + lookup('ansible.builtin.vars',
  'ssl_exporter_dest') + '/ssl_exporter.yml' -}}
{% if lookup('ansible.builtin.vars', 'ssl_exporter_options', default='')
  not in ['', [], '[]', None] %}
{% for s in vars['ssl_exporter_options'] %}
{% if s['web_listen_address'] is defined and s['web_listen_address']
  not in ['', [], '[]', None] %}
{{ ' \\' }}
{{ ' --web.listen-address=' + s['web_listen_address'] -}}
{% endif %}
{% if s['web_metrics_path'] is defined and s['web_metrics_path']
  not in ['', [], '[]', None] %}
{{ ' \\' }}
{{ ' --web.metrics-path=' + s['web_metrics_path'] -}}
{% endif %}
{% if s['web_probe_path'] is defined and s['web_probe_path']
  not in ['', [], '[]', None] %}
{{ ' \\' }}
{{ ' --web.probe-path=' + s['web_probe_path'] -}}
{% endif %}
{% if s['log_level'] is defined and s['log_level'] in ['debug', 'info', 'warn',
  'error', 'fatal'] %}
{{ ' \\' }}
{{ ' --log.level=' + s['log_level'] -}}
{% endif %}
{% if s['log_format'] is defined and s['log_format'] in ['logfmt', 'json'] %}
{{ ' \\' }}
{{ ' --log.format=' + s['log_format'] -}}
{% endif %}
{% if loop['last'] %}
{{ '' }}
{% endif %}
{% endfor %}
{% endif %}

{{ '[Install]' }}
{{ 'WantedBy=multi-user.target' }}
